public class Main {

    public static void insertionSort(int[] arr) {
        int n = arr.length;

        for (int i = 1; i < n; i++) {
            int key = arr[i];
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j--;
            }

            arr[j + 1] = key;
        }
    }

    public static void main(String[] args) {

        int[] bookPrices = {25, 10, 40, 15, 30};

        insertionSort(bookPrices);

        System.out.println("Sorted Book Prices:");
        for (int price : bookPrices) {
            System.out.print("$" + price + " ");
        }
    }
}
