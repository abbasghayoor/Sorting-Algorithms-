public class Main {
    public static void main(String[] args) {
        int[] bookThickness = {5, 2, 8, 3, 6, 4, 7};
        for (int i = 0; i < bookThickness.length - 1; i++) {
            for (int j = 0; j < bookThickness.length - i - 1; j++) {
                if (bookThickness[j] > bookThickness[j + 1]) {
                    int temp = bookThickness[j];
                    bookThickness[j] = bookThickness[j + 1];
                    bookThickness[j + 1] = temp;
                }
            }
        }
        System.out.println("Sorted Book Thicknesses:");
        for (int thickness : bookThickness) {
            System.out.print(thickness + " ");
        }
        System.out.println("\nThinnest Book: " + bookThickness[0] + " cm");
        System.out.println("Thickest Book: " + bookThickness[bookThickness.length - 1] + " cm");
    }
}
