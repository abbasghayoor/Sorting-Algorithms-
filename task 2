import java.util.Scanner;
public class Main {
    public static void selectionSort(int[] arr) {
        int n = arr.length;
        for (int i = 0; i < n - 1; i++) {
            int min = i;

            for (int j = i + 1; j < n; j++) {
                if (arr[j] < arr[min]) {
                    min = j;
                }
            }
            int temp = arr[min];
            arr[min] = arr[i];
            arr[i] = temp;
        }
    }
    public static int binarySearch(int[] arr, int key) {
        int low = 0;
        int high = arr.length - 1;
        while (low <= high) {
            int mid = (low + high) / 2;

            if (arr[mid] == key) {
                return mid;
            } else if (arr[mid] < key) {
                low = mid + 1;
            } else {
                high = mid - 1;
            }
        }

        return -1;
    }

    public static void main(String[] args) {

        int[] packageWeights = {45, 12, 33, 18, 27, 50, 39};

        selectionSort(packageWeights);

        System.out.println("Sorted Package Weights:");
        for (int weight : packageWeights) {
            System.out.print(weight + " ");
        }

        Scanner sc = new Scanner(System.in);
        System.out.print("\nEnter package weight to search: ");
        int key = sc.nextInt();

        int result = binarySearch(packageWeights, key);

        if (result != -1) {
            System.out.println("Package found at index: " + result);
        } else {
            System.out.println("Package not found.");
        }

        sc.close();
    }
}
