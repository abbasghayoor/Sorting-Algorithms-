public class Main {

    public static void bubbleSort(int[] scores) {
        int n = scores.length;

        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (scores[j] > scores[j + 1]) {
                    int temp = scores[j];
                    scores[j] = scores[j + 1];
                    scores[j + 1] = temp;
                }
            }
        }
    }

    public static void main(String[] args) {

        int[] scores = {550, 720, 480, 900, 600, 750, 820, 500, 680, 950};

        bubbleSort(scores);

        System.out.println("Leaderboard (Lowest to Highest):");
        for (int score : scores) {
            System.out.print(score + " ");
        }

        System.out.println("\nTop Qualifier: " + scores[scores.length - 1]);
    }
}
